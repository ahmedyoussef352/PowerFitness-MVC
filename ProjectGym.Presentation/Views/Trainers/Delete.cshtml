@{
    ViewData["Title"] = "Delete";
}

<div class="container mt-5">
    <partial name="_TempDataAlerts" />
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card confirm-card p-5 text-center bg-white">
                <p class="fs-4 fw-semibold text-primary-color mb-4">Are you sure you want to delete this Trainer?</p>

                <div class="alert confirm-warning text-start py-3 px-3 mb-4" role="alert">
                    <strong>Warning!</strong> This action cannot be undone. All Trainer data will be permanently deleted.
                </div>
                <form asp-action="Delete" asp-route-id="@ViewBag.TrainerId" method="post" class="mt-2">
                    <div class="d-flex justify-content-between gap-3">
                        <a asp-controller="Trainers" asp-action="Index" class="btn btn-confirm-no flex-fill py-2">NO</a>
                        <button type="submit" class="btn btn-confirm-yes flex-fill py-2">Yes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
