@{
    ViewData["Title"] = "Member Details";
}
@model MemberDetailsViewModel
<div class="container">
    <main role="main" class="pb-3">
        <div class="container mt-5">
            <div class="row justify-content-center">
                <div class="col-md-6">
                    <div class="card gym-card border-0 p-3 pt-0 mt-5">
                        <div class="text-center">
                            <img src="@(string.IsNullOrWhiteSpace(Model.PhotoUrl) ? Url.Content("~/images/card-header.jpg") : Model.PhotoUrl)" alt="MemberName" class="rounded-circle gym-avatar" />
                        </div>
                        <div class="card-body text-center pt-3">
                            <h2 class="mb-1 text-primary-color fw-bold">@Model.Name</h2>
                            <h5 class="mb-2 pb-3 border-bottom d-block text-black-alternative">@(Model.PlanName)</h5>
                            <div class="mt-4 text-start">
                                <div class="row g-3">
                                    <div class="col-12">
                                        <div class="gym-info-box">
                                            <small class="text-muted d-block mb-1">Email</small>
                                            <strong>@Model.Email</strong>
                                        </div>
                                    </div>
                                    <div class="col-12">
                                        <div class="gym-info-box">
                                            <small class="text-muted d-block mb-1">Phone</small>
                                            <strong>@Model.Phone</strong>
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="gym-info-box">
                                            <small class="text-muted d-block mb-1">Gender</small>
                                            <strong>@Model.Gender</strong>
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="gym-info-box">
                                            <small class="text-muted d-block mb-1">Date of Birth</small>
                                            <strong>@Model.DateOfBirth</strong>
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="gym-info-box">
                                            <small class="text-muted d-block mb-1">Membership Start Date</small>
                                            <strong>@Model.MembershipStartDate</strong>
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="gym-info-box">
                                            <small class="text-muted d-block mb-1">Membership End Date</small>
                                            <strong>@Model.MembershipEndDate</strong>
                                        </div>
                                    </div>
                                    <div class="col-12">
                                        <div class="gym-info-box">
                                            <small class="text-muted d-block mb-1">Address</small>
                                            <strong>@Model.Address</strong>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="px-3 pb-3">
                            <a asp-controller="Members" asp-action="Index" class="btn btn-fill w-100 py-2">Back to List</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>
</div>
