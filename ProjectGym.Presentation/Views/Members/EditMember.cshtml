@model EditMemberViewModel
<div class="container">
    <main role="main" class="pb-3">
        <partial name="_TempDataAlerts" />

        <div class="container mt-5">
            <div class="row justify-content-center">
                <div class="col-md-6">
                    <div class="card gym-card border-0 p-3 pt-0 mt-5">
                        <div class="text-center">
                            <img src="@(string.IsNullOrWhiteSpace(Model.Photo) ? Url.Content("~/images/card-header.jpg") : Model.Photo)" alt="@Model.Name" class="rounded-circle gym-avatar" />
                        </div>
                        <div class="card-body text-center pt-3">
                            <h2 class="mb-1 text-primary-color fw-bold">@Model.Name</h2>
                            <form asp-controller="Members" asp-action="EditMember" method="post" asp-route-id="@Context.Request.RouteValues["id"]">
                                <input type="hidden" asp-for="Name" />
                                <div class="mt-4 text-start">
                                    <div class="row g-3">
                                        <div class="col-12">
                                            <div class="gym-info-box">
                                                <small class="text-muted d-block mb-1">Email</small>
                                                <input asp-for="Email" class="form-control" />
                                                <span asp-validation-for="Email" class="text-danger"></span>
                                            </div>
                                        </div>
                                        <div class="col-6">
                                            <div class="gym-info-box">
                                                <small class="text-muted d-block mb-1">Phone</small>
                                                <input asp-for="Phone" class="form-control" />
                                                <span asp-validation-for="Phone" class="text-danger"></span>
                                            </div>
                                        </div>
                                        <div class="col-6">
                                            <div class="gym-info-box">
                                                <small class="text-muted d-block mb-1">Building Number</small>
                                                <input asp-for="BuildingNumber" class="form-control" />
                                                <span asp-validation-for="BuildingNumber" class="text-danger"></span>
                                            </div>
                                        </div>
                                        <div class="col-6">
                                            <div class="gym-info-box">
                                                <small class="text-muted d-block mb-1">City</small>
                                                <input asp-for="City" class="form-control" />
                                                <span asp-validation-for="City" class="text-danger"></span>
                                            </div>
                                        </div>
                                        <div class="col-6">
                                            <div class="gym-info-box">
                                                <small class="text-muted d-block mb-1">Street</small>
                                                <input asp-for="Street" class="form-control" />
                                                <span asp-validation-for="Street" class="text-danger"></span>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="d-flex justify-content-between gap-3 mt-4">
                                    <a asp-controller="Members" asp-action="Index" class="btn btn-fill rounded-pill px-4">Back to List</a>
                                    <button type="submit" class="btn btn-fill rounded-pill px-5">Done</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
