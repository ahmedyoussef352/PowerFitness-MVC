@{
    ViewData["Title"] = "Add Member";
}
@model CreateMemberViewModel

<div class="container">
    <main role="main" class="pb-3">
        <partial name="_TempDataAlerts" />
        <header class="mb-4">
            <h3 class="text-primary-color">Add Member</h3>
        </header>

        <form asp-controller="Members" asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <!-- Personal Information Section -->
            <div class="card shadow-sm p-4 mb-4">
                <div class="section-header mb-3">
                    <h5 class="text-primary fw-bold">Personal Information</h5>
                    <hr class="mt-2">
                </div>
                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" type="text" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" type="text" class="form-control" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="Phone" class="form-label"></label>
                        <input asp-for="Phone" type="text" class="form-control" />
                        <span asp-validation-for="Phone" class="text-danger"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="DateOfBirth" class="form-label"></label>
                        <input asp-for="DateOfBirth" class="form-control" type="date" />
                        <span asp-validation-for="DateOfBirth" class="text-danger"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="Gender" class="form-label"></label>
                        <select asp-for="Gender" class="form-select" asp-items="Html.GetEnumSelectList<Gender>()">
                            <option value="">-- Select Gender --</option>
                        </select>
                        <span asp-validation-for="Gender" class="text-danger"></span>
                    </div>
                </div>

                <div class="section-header mb-3 mt-4">
                    <h5 class="text-primary fw-bold">Address Information</h5>
                    <hr class="mt-2">
                </div>
                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <label asp-for="BuildingNumber" class="form-label"></label>
                        <input asp-for="BuildingNumber" class="form-control" />
                        <span asp-validation-for="BuildingNumber" class="text-danger"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="Street" class="form-label"></label>
                        <input asp-for="Street" class="form-control" />
                        <span asp-validation-for="Street" class="text-danger"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="City" class="form-label"></label>
                        <input asp-for="City" class="form-control" />
                        <span asp-validation-for="City" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <!-- Health Data Section -->
            <div class="card shadow-sm p-4 mb-4">
                <div class="section-header mb-3">
                    <h5 class="text-primary fw-bold">Health Data</h5>
                    <hr class="mt-2">
                </div>
                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <label asp-for="HealthRecord.Height" class="form-label"></label>
                        <input asp-for="HealthRecord.Height" class="form-control" />
                        <span asp-validation-for="HealthRecord.Height" class="text-danger"></span>

                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="HealthRecord.Weight" class="form-label"></label>
                        <input asp-for="HealthRecord.Weight" class="form-control" />
                        <span asp-validation-for="HealthRecord.Weight" class="text-danger"></span>

                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="HealthRecord.BloodType" class="form-label"></label>
                        <select asp-for="HealthRecord.BloodType" class="form-select" asp-items="Html.GetEnumSelectList<BloodType>()">
                            <option value="">Select</option>
                        </select>
                        <span asp-validation-for="HealthRecord.BloodType" class="text-danger"></span>

                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="HealthRecord.Notes" class="form-label"></label>
                        <input asp-for="HealthRecord.Notes" class="form-control" />
                    </div>
                </div>
            </div>

            <footer class="d-flex justify-content-end gap-3 mt-4">
                <a asp-controller="Members" asp-action="Index" class="btn btn-outline-secondary px-4">
                    <i class="bi bi-arrow-left me-2"></i> Back to List
                </a>

                <button type="submit" class="btn btn-primary px-4">
                    <i class="bi bi-plus-circle me-2"></i> Add
                </button>
            </footer>

        </form>

    </main>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_TempDataAlerts" />
}