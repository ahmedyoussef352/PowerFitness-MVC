@model MemberDeleteViewModel

<div class="container mt-5">
    <partial name="_TempDataAlerts" />
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card confirm-card p-4 text-center bg-white shadow-sm rounded-4">

                <div class="mb-3">
                    <img src="@(string.IsNullOrWhiteSpace(Model.PhotoUrl) ? Url.Content("~/images/card-header.jpg") : Model.PhotoUrl)" alt="@Model.Name" class="rounded-circle gym-avatar" />
                </div>

                <h4 class="fw-bold text-primary-color mb-1">Delete @Model.Name?</h4>
                <p class="text-muted small mb-4">Review member details before confirming.</p>

                <div class="text-start mb-3">
                    <div class="p-2 bg-light rounded border-0 mb-2">
                        <span class="d-block text-muted" style="font-size: 0.75rem;">Phone</span>
                        <span class="fw-semibold text-dark">@Model.Phone</span>
                    </div>

                    <div class="p-2 bg-light rounded border-0 mb-2">
                        <span class="d-block text-muted" style="font-size: 0.75rem;">Plan</span>
                        <span class="fw-semibold text-dark">@(string.IsNullOrEmpty(Model.PlanName) ? "No Active Plan" : Model.PlanName)</span>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <div class="p-2 bg-light rounded border-0">
                                <span class="d-block text-muted" style="font-size: 0.75rem;">Membership Start</span>
                                <span class="fw-semibold text-dark">@Model.MembershipStartDate</span>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="p-2 bg-light rounded border-0">
                                <span class="d-block text-muted" style="font-size: 0.75rem;">Membership End</span>
                                <span class="fw-semibold text-dark">@Model.MembershipEndDate</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="alert confirm-warning text-start py-2 px-3 mb-4 small" role="alert" style="background-color: #fff9e6; border-color: #ffeeba; color: #856404;">
                    <strong>Warning!</strong> This member will be deactivated and hidden from active records.
                </div>

                <form asp-action="Delete" method="post" class="mt-2">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <div class="d-flex justify-content-between gap-3">
                        <a asp-controller="Members" asp-action="Index" class="btn btn-outline-dark flex-fill py-2 fw-semibold">NO</a>
                        <button type="submit" class="btn btn-primary flex-fill py-2 fw-semibold" style="background-color: #0c0859; border-color: #0c0859;">Yes</button>
                    </div>
                </form>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}